datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    extensions = [pgcrypto]
}

generator client {
    provider        = "prisma-client-js"
    output          = "../prisma_dist"
    previewFeatures = ["driverAdapters", "typedSql", "postgresqlExtensions"]
}

